{{- $.Scratch.Add "index" slice -}}

{{- /* Index complete page text plus discovery metadata. */ -}}
{{- range .Site.RegularPages -}}
  {{- $.Scratch.Add "index" (dict "title" .Title "href" .Permalink "description" .Description "content" .Plain "section" .Section "kind" .Kind "tags" (.Params.tags | default slice) "aliases" (.Aliases | default slice)) -}}
{{- end -}}

{{- /* Include section landing pages so task and persona entry points are searchable. */ -}}
{{- range where .Site.Pages "Kind" "section" -}}
  {{- $.Scratch.Add "index" (dict "title" .Title "href" .Permalink "description" .Description "content" .Plain "section" .Section "kind" .Kind "tags" (.Params.tags | default slice) "aliases" (.Aliases | default slice)) -}}
{{- end -}}

{{- $.Scratch.Get "index" | jsonify -}}